# ARKHEIA DVE — cps_backend runs in VERIFY-ONLY (gateway guard) mode.
# This service holds NO private signing keys: never set ARKHEIA_SIGNING_SEED_HEX or
# ARKHEIA_SIGNING_PUBLIC_KEY_ID here. The receipt gateway fails closed (HTTP 502/503)
# if a signing seed is present in the environment or if the trusted keyring is missing.
ARKHEIA_ENGINE_ID=cps_platform
# Published keyring of trusted engine public keys (verification only).
ARKHEIA_TRUSTED_KEYS_FILE=./arkheia-public-keys.json
